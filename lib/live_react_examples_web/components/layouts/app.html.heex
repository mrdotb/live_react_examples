<.site_header />

<main class="flex-1">
  <div class="px-8 flex-1 items-start md:grid md:grid-cols-[220px_minmax(0,1fr)] md:gap-6 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-10">
    <aside class="fixed top-14 z-30 -ml-2 hidden h-[calc(100vh-3.5rem)] w-full shrink-0 md:sticky md:block">
      <div class="relative overflow-hidden h-full py-6 pr-6 lg:py-8">
        <div class="h-full w-full rounded-[inherit]">
          <.example_nav current={assigns[:example][:id]} />
        </div>
      </div>
    </aside>
    <main class="relative py-6 lg:gap-10 lg:py-8 xl:grid xl:grid-cols-[1fr_300px]">
      <div class="mx-auto w-full min-w-0">
        <%!--
          `@demo` is only set (by `LiveDemoAssigns`) for the thirteen legacy
          routes it knows about. The new registry-driven example pages (under
          `/examples`) bring their own page chrome via `ExampleComponents.example_page/1`
          and are not in that switch, so `@demo` is `nil` for them — render
          their content directly rather than through the old `<.demo>` tabs,
          which requires a known demo name.
        --%>
        <%= if @demo do %>
          <.demo demo={@demo}>
            {@inner_content}
          </.demo>
        <% else %>
          {@inner_content}
        <% end %>
      </div>
    </main>
  </div>
</main>
<.site_footer />
<.react :if={@demo == :flash_sonner} name="FlashSonner" flash={@flash} socket={assigns[:socket]} />
<.flash_group flash={@flash} />
